<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="videobox" method="upgrade" version="4.0"
    xmlns="urn:joomla.org:extension:manifest:1.0">

    <name>plg_videobox_html5</name>
    <creationDate>August 2023</creationDate>
    <author>HitkoDev</author>
    <authorEmail>development@hitko.si</authorEmail>
    <authorUrl>https://hitko.eu/videobox/</authorUrl>
    <copyright>Copyright (C) 2016 HitkoDev</copyright>
    <license>GNU/GPLv3 http://www.gnu.org/licenses/gpl-3.0.html</license>
    <version>6.0.0</version>
    <description>PLG_VIDEOBOX_HTML5_XML_DESCRIPTION</description>

    <files>
        <filename plugin="html5">html5.php</filename>
        <filename>index.html</filename>
    </files>

    <config>
        <fields name="params">
            <fieldset name="basic" label="PLG_VIDEOBOX_HTML5_FIELDSET_BASIC">
                <field 
                    name="h5Convert" 
                    type="radio" 
                    default="0" 
                    label="PLG_VIDEOBOX_HTML5_H5CONVERT_LABEL" 
                    description="PLG_VIDEOBOX_HTML5_H5CONVERT_DESC"
                    class="btn-group">
                    <option value="1">JON</option>
                    <option value="0">JOFF</option>
                </field>

                <field 
                    name="playerTpl" 
                    type="textarea" 
                    rows="10" 
                    cols="75" 
                    filter="raw" 
                    class="vb-tpl" 
                    label="PLG_VIDEOBOX_HTML5_PLAYERTPL_LABEL" 
                    description="PLG_VIDEOBOX_HTML5_PLAYERTPL_DESC" 
                    default="&lt;!DOCTYPE html>&#10;&lt;html class=&quot;vb-html5-player&quot;> ... " 
                />
            </fieldset>
        </fields>
    </config>
</extension>
